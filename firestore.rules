rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsRide(rideId) {
      return signedIn()
        && get(/databases/$(database)/documents/rides/$(rideId)).data.customerId == request.auth.uid;
    }

    function approvedDriver(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/drivers/$(uid))
        && get(/databases/$(database)/documents/drivers/$(uid)).data.approved == true;
    }

    function hasRideRequest(uid, rideId) {
      return exists(/databases/$(database)/documents/drivers/$(uid)/requests/$(rideId));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'role', 'name', 'phone', 'fcmToken', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.role in ['customer', 'driver']
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && (!request.resource.data.keys().hasAny(['fcmToken']) || request.resource.data.fcmToken is string)
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'role', 'name', 'phone', 'fcmToken', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.role in ['customer', 'driver']
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && (!request.resource.data.keys().hasAny(['fcmToken']) || request.resource.data.fcmToken is string)
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }

    match /drivers/{driverId} {
      allow get: if signedIn() && (
        request.auth.uid == driverId || resource.data.approved == true || isAdmin()
      );
      allow list: if signedIn() && (resource.data.approved == true || isAdmin());

      // New driver application.
      allow create: if signedIn()
        && request.auth.uid == driverId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'phone', 'licenseType', 'vehicleType',
          'idCardImageUrl', 'vehicleImageUrl', 'approved', 'available',
          'lat', 'lon', 'geohash', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == driverId
        && request.resource.data.displayName is string
        && request.resource.data.phone is string
        && request.resource.data.licenseType is string
        && request.resource.data.vehicleType is string
        && request.resource.data.idCardImageUrl is string
        && request.resource.data.vehicleImageUrl is string
        && request.resource.data.approved == false
        && request.resource.data.available == false
        && request.resource.data.lat is number
        && request.resource.data.lon is number
        && request.resource.data.geohash is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && (
          // Pending driver can edit only their application fields.
          (
            request.auth.uid == driverId
            && resource.data.approved == false
            && request.resource.data.approved == false
            && request.resource.data.available == false
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'phone', 'licenseType', 'vehicleType',
              'idCardImageUrl', 'vehicleImageUrl', 'updatedAt'
            ])
            && request.resource.data.displayName is string
            && request.resource.data.phone is string
            && request.resource.data.licenseType is string
            && request.resource.data.vehicleType is string
            && request.resource.data.idCardImageUrl is string
            && request.resource.data.vehicleImageUrl is string
            && request.resource.data.updatedAt == request.time
          )
          ||
          // Approved driver can update only operational/location fields.
          (
            request.auth.uid == driverId
            && resource.data.approved == true
            && request.resource.data.approved == resource.data.approved
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'available', 'lat', 'lon', 'geohash', 'updatedAt'
            ])
            && request.resource.data.available is bool
            && request.resource.data.lat is number
            && request.resource.data.lon is number
            && request.resource.data.geohash is string
            && request.resource.data.updatedAt == request.time
          )
          ||
          // Admin can approve/revoke, but cannot leave an unapproved driver online.
          (
            isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'approved', 'available', 'updatedAt'
            ])
            && request.resource.data.approved is bool
            && request.resource.data.available == false
            && request.resource.data.updatedAt == request.time
          )
        );

      match /requests/{rideId} {
        allow get, list: if signedIn() && request.auth.uid == driverId;

        allow create: if false; // الطلبات تُنشأ فقط عبر Cloud Function (Admin SDK)

        allow update: if signedIn()
          && ownsRide(rideId)
          && getAfter(/databases/$(database)/documents/rides/$(rideId)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/rides/$(rideId)).data.selectedDriverId == driverId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'selected';
      }
    }

    match /rides/{rideId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status in ['searching', 'scheduled']
        && request.resource.data.searchRadiusMeters == 500
        && request.resource.data.searchStage == 0
        && request.resource.data.invitedDriverIds is list
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasAll([
          'customerId', 'customerName', 'fromAddress', 'toAddress', 'fromLat', 'fromLon',
          'toLat', 'toLon', 'distanceKm', 'femaleMode', 'withLuggage', 'bookingType', 'status',
          'searchRadiusMeters', 'searchStage', 'invitedDriverIds', 'scheduledAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'customerId', 'customerName', 'fromAddress', 'toAddress', 'fromLat', 'fromLon',
          'toLat', 'toLon', 'distanceKm', 'femaleMode', 'withLuggage', 'bookingType', 'status',
          'searchRadiusMeters', 'searchStage', 'invitedDriverIds', 'scheduledAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.bookingType in ['now', 'school']
        && ((request.resource.data.bookingType == 'now' && request.resource.data.status == 'searching' && request.resource.data.scheduledAt == null) || (request.resource.data.bookingType == 'school' && request.resource.data.status == 'scheduled' && request.resource.data.scheduledAt is timestamp));

      allow get: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || (approvedDriver(request.auth.uid)
          && resource.data.status == 'searching'
          && hasRideRequest(request.auth.uid, rideId))
        || (resource.data.status in ['accepted', 'driver_arriving', 'driver_arrived', 'in_progress']
          && resource.data.selectedDriverId == request.auth.uid)
      );

      allow list: if signedIn() && resource.data.customerId == request.auth.uid;

      allow update: if signedIn()
        && (
          (
            resource.data.customerId == request.auth.uid
            && resource.data.status in ['searching', 'scheduled']
            && request.resource.data.status in ['offered', 'no_drivers', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            resource.data.customerId == request.auth.uid
            && resource.data.status == 'offered'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            resource.data.customerId == request.auth.uid
            && resource.data.status in ['searching', 'offered']
            && request.resource.data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'selectedDriverId', 'selectedOfferId', 'selectedPrice', 'updatedAt'
            ])
            && request.resource.data.selectedDriverId == request.resource.data.selectedOfferId
            && request.resource.data.selectedPrice is int
            && request.resource.data.selectedPrice >= 1
            && exists(/databases/$(database)/documents/rides/$(rideId)/offers/$(request.resource.data.selectedOfferId))
            && getAfter(/databases/$(database)/documents/rides/$(rideId)/offers/$(request.resource.data.selectedOfferId)).data.status == 'selected'
          )
          || (
            resource.data.selectedDriverId == request.auth.uid
            && resource.data.status in ['accepted', 'driver_arriving', 'driver_arrived', 'in_progress']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && (
              (resource.data.status == 'accepted' && request.resource.data.status == 'driver_arriving')
              || (resource.data.status == 'driver_arriving' && request.resource.data.status == 'driver_arrived')
              || (resource.data.status == 'driver_arrived' && request.resource.data.status == 'in_progress')
              || (resource.data.status == 'in_progress' && request.resource.data.status in ['completed', 'cancelled'])
              || (resource.data.status in ['accepted', 'driver_arriving', 'driver_arrived'] && request.resource.data.status == 'cancelled')
            )
          )
          || (
            resource.data.customerId == request.auth.uid
            && resource.data.status in ['accepted', 'driver_arriving', 'driver_arrived']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      match /ratings/{raterId} {
        allow get: if signedIn() && (
          ownsRide(rideId) ||
          get(/databases/$(database)/documents/rides/$(rideId)).data.selectedDriverId == request.auth.uid
        );
        allow create: if signedIn()
          && request.auth.uid == raterId
          && get(/databases/$(database)/documents/rides/$(rideId)).data.status == 'completed'
          && (
            get(/databases/$(database)/documents/rides/$(rideId)).data.customerId == request.auth.uid
            || get(/databases/$(database)/documents/rides/$(rideId)).data.selectedDriverId == request.auth.uid
          )
          && request.resource.data.keys().hasOnly(['raterId', 'stars', 'comment', 'createdAt'])
          && request.resource.data.raterId == request.auth.uid
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 300
          && request.resource.data.createdAt == request.time;
        allow update, delete, list: if false;
      }

      match /private/{privateId} {
        allow create: if signedIn()
          && ownsRide(rideId)
          && privateId == 'contact'
          && request.resource.data.keys().hasOnly(['customerPhone'])
          && request.resource.data.customerPhone is string;
        allow get: if signedIn() && (
          ownsRide(rideId)
          || (get(/databases/$(database)/documents/rides/$(rideId)).data.status in ['accepted', 'driver_arriving', 'driver_arrived', 'in_progress']
            && get(/databases/$(database)/documents/rides/$(rideId)).data.selectedDriverId == request.auth.uid)
        );
        allow list, update, delete: if false;
      }

      match /offers/{driverId} {
        allow get, list: if signedIn() && (
          ownsRide(rideId) || request.auth.uid == driverId
        );

        allow create: if signedIn()
          && request.auth.uid == driverId
          && approvedDriver(driverId)
          && hasRideRequest(driverId, rideId)
          && get(/databases/$(database)/documents/rides/$(rideId)).data.status == 'searching'
          && request.resource.data.driverId == driverId
          && request.resource.data.price is int
          && request.resource.data.price >= 1
          && request.resource.data.price <= 100000
          && request.resource.data.etaMinutes is int
          && request.resource.data.etaMinutes >= 1
          && request.resource.data.etaMinutes <= 240
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly([
            'driverId', 'driverName', 'price', 'etaMinutes', 'status', 'createdAt'
          ]);

        allow update: if ownsRide(rideId)
          && getAfter(/databases/$(database)/documents/rides/$(rideId)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/rides/$(rideId)).data.selectedOfferId == driverId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'selected';

        allow delete: if false;
      }
    }
  }
}
